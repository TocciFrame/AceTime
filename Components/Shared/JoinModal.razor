@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string Title { get; set; } = "Brooklyn Summer Slam";
    [Parameter] public string Price { get; set; } = "$80.00";

    private bool isProcessing = false;
    private bool isSuccess = false;

    private async Task HandlePayment()
    {
        isProcessing = true;
        StateHasChanged();

        // Simulate network/payment delay
        await Task.Delay(1500);

        isProcessing = false;
        isSuccess = true;
        StateHasChanged();

        // Auto-close after success
        await Task.Delay(2000);
        await OnClose.InvokeAsync();
        
        // Reset for next opening
        isSuccess = false;
    }
}

@if (IsVisible)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-6 antialiased font-sans">
        
        <!-- 1. BACKDROP: Pure Tailwind Glassmorphism -->
        <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-md transition-opacity" @onclick="OnClose"></div>
        
        <!-- 2. MODAL CARD -->
        <div class="relative bg-white rounded-[40px] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.3)] w-full max-w-lg overflow-hidden border border-slate-100 transform transition-all animate-[zoom-in_0.3s_ease-out]">
            
            @if (!isSuccess)
            {
                <!-- HEADER IMAGE SECTION -->
                <div class="h-44 bg-slate-900 relative overflow-hidden">
                    <img src="/tennis.jpeg" class="absolute inset-0 w-full h-full object-cover opacity-50" />
                    <!-- Close Button -->
                    <button @onclick="OnClose" class="absolute top-6 right-6 w-10 h-10 bg-black/20 hover:bg-orange-500 text-white rounded-full flex items-center justify-center transition-all backdrop-blur-md border border-white/10">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                
                <!-- CONTENT SECTION -->
                <div class="p-10">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
                        <span class="text-[10px] font-black text-orange-500 uppercase tracking-[0.2em] italic">Registration Open</span>
                    </div>
                    <h3 class="text-4xl font-[800] tracking-tighter italic uppercase text-slate-900 leading-none">@Title</h3>
                    
                    <div class="mt-10 space-y-5">
                        <!-- Price Row -->
                        <div class="flex justify-between items-end border-b border-slate-100 pb-5">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Team Entry Fee</span>
                            <span class="text-2xl font-black italic text-slate-900">@Price</span>
                        </div>
                        
                        <!-- Skill Row -->
                        <div class="flex justify-between items-center border-b border-slate-100 pb-5">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Required Level</span>
                            <div class="bg-emerald-50 text-emerald-600 px-4 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-tight border border-emerald-100">
                                4.0+ Verified
                            </div>
                        </div>
                    </div>

                    <!-- ACTION BUTTON -->
                    <button @onclick="HandlePayment" disabled="@isProcessing" 
                            class="w-full py-5 @(isProcessing ? "bg-slate-300 cursor-not-allowed" : "bg-slate-900 hover:bg-orange-600") text-white rounded-3xl font-black uppercase tracking-[0.1em] mt-10 transition-all shadow-xl shadow-slate-900/20 active:scale-[0.98] flex justify-center items-center gap-3">
                        @if (isProcessing)
                        {
                            <div class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                            <span class="italic">Securing Spot...</span>
                        }
                        else
                        {
                            <span>Confirm & Pay Now</span>
                        }
                    </button>
                    
                    <p class="text-center text-[9px] text-slate-400 uppercase font-bold mt-6 tracking-[0.2em]">Secure checkout powered by AceTime Pay</p>
                </div>
            }
            else
            {
                <!-- 3. SUCCESS STATE: High Impact Athletic Visual -->
                <div class="p-20 text-center flex flex-col items-center animate-[fade-in_0.5s_ease-out]">
                    <div class="relative mb-8">
                        <div class="w-24 h-24 bg-emerald-500 text-white rounded-full flex items-center justify-center text-5xl shadow-2xl shadow-emerald-500/40 animate-[bounce_1s_infinite]">
                            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <!-- Decorative Rings -->
                        <div class="absolute inset-0 w-24 h-24 border-4 border-emerald-500 rounded-full animate-ping opacity-20"></div>
                    </div>
                    
                    <h3 class="text-4xl font-[900] tracking-tighter italic uppercase text-slate-900">See you on the court!</h3>
                    <p class="text-slate-500 font-medium mt-3 max-w-[240px]">Registration for <span class="text-slate-900 font-bold">@Title</span> is officially confirmed.</p>
                    
                    <div class="mt-10 bg-slate-50 px-6 py-3 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-400 border border-slate-100">
                        Redirecting to Dashboard...
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    @@keyframes zoom-in {
        from { opacity: 0; transform: scale(0.95) translateY(10px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    @@keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>