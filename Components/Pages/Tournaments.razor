@page "/tournaments"

<div class="p-10 max-w-6xl mx-auto">
    <header class="flex justify-between items-end mb-12">
        <div>
            <h1 class="text-5xl font-[800] tracking-tighter text-slate-900">Active Tournaments</h1>
            <p class="text-slate-400 font-medium mt-2">Join or track live competitions in your area.</p>
        </div>
        <div class="flex bg-slate-100 p-1.5 rounded-2xl">
            <button class="px-6 py-2 bg-white rounded-xl shadow-sm text-xs font-bold uppercase tracking-widest">Active</button>
            <button class="px-6 py-2 text-slate-400 text-xs font-bold uppercase tracking-widest">Upcoming</button>
        </div>
    </header>

    <!-- TOURNAMENT LIST -->
    <div class="grid grid-cols-1 gap-6">
        @for(int i=0; i<3; i++)
        {
            <div class="bg-white border border-slate-100 p-2 rounded-[32px] flex items-center shadow-sm hover:shadow-xl transition-all group">
                <!-- Mini Image -->
                <div class="w-48 h-48 rounded-[24px] overflow-hidden relative shrink-0">
                    <img src="/tennis.jpeg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                    <div class="absolute inset-0 bg-black/20"></div>
                    <span class="absolute top-4 left-4 bg-red-500 text-white text-[8px] font-black px-2 py-1 rounded-md uppercase animate-pulse">Live</span>
                </div>

                <div class="flex-1 px-8">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-2xl font-[800] tracking-tight text-slate-900">Brooklyn Open Phase @(i + 1)</h3>
                            <p class="text-slate-400 text-xs font-bold uppercase tracking-widest mt-1">McCarren Park • Singles</p>
                        </div>
                        <span class="bg-orange-50 text-orange-600 px-3 py-1 rounded-lg text-[10px] font-black">$2,500 Prize</span>
                    </div>

                    <div class="flex gap-12 mt-8">
                        <div>
                            <p class="text-xs font-black text-slate-900 italic">Quarter Finals</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Current Stage</p>
                        </div>
                        <div>
                            <p class="text-xs font-black text-slate-900 italic">12 / 16</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Players</p>
                        </div>
                    </div>
                </div>

                <div class="pr-8">
                    <a href="/bracket/brooklyn-slam" class="bg-[#111111] text-white px-8 py-4 rounded-2xl text-xs font-bold hover:bg-orange-600 transition-all flex items-center gap-2">
                        View Bracket <span>↗</span>
                    </a>
                </div>
            </div>
        }
    </div>
</div>