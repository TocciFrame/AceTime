@page "/create-tournament"

<div class="min-h-screen bg-slate-50 p-10 flex items-center justify-center font-['Plus_Jakarta_Sans']">
    <div class="bg-white rounded-[48px] shadow-2xl w-full max-w-3xl overflow-hidden flex flex-col md:flex-row border border-slate-100">
        
        <!-- Left Visual Side -->
        <div class="md:w-1/3 bg-slate-900 p-12 text-white flex flex-col justify-between">
            <div>
                <span class="text-orange-500 font-black text-xs uppercase tracking-widest">Step 1 of 3</span>
                <h2 class="text-4xl font-[800] tracking-tighter mt-4 leading-tight italic uppercase">Launch your Event</h2>
            </div>
            <div class="text-slate-500 text-[10px] uppercase font-bold tracking-widest leading-loose">
                Organize round robins, single elimination, or social mixers.
            </div>
        </div>

        <!-- Form Side -->
        <div class="md:w-2/3 p-12">
            <div class="space-y-6">
                <div>
                    <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Tournament Name</label>
                    <input type="text" placeholder="e.g. Fall Tennis Classic" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-4 px-6 outline-none focus:ring-2 focus:ring-orange-500/20" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Sport</label>
                        <select class="w-full bg-slate-50 border border-slate-100 rounded-xl py-4 px-6 outline-none">
                            <option>Tennis</option>
                            <option>Pickleball</option>
                            <option>Padel</option>
                        </select>
                    </div>
                    <div>
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 block">Prize Pool ($)</label>
                        <input type="number" placeholder="500" class="w-full bg-slate-50 border border-slate-100 rounded-xl py-4 px-6 outline-none" />
                    </div>
                </div>

                <div class="pt-8 flex gap-4">
                    <a href="/home" class="flex-1 text-center py-4 rounded-2xl text-xs font-bold text-slate-400 border border-slate-100 hover:bg-slate-50">Cancel</a>
                    <button class="flex-[2] py-4 bg-[#111111] text-white rounded-2xl text-xs font-bold uppercase tracking-widest hover:bg-orange-600 transition-all">Next: Set Brackets</button>
                </div>
            </div>
        </div>
    </div>
</div>