@page "/home"

<div class="min-h-screen bg-[#F8FAFC] font-['Plus_Jakarta_Sans'] text-slate-900">
    <main class="max-w-[1600px] mx-auto px-6 py-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- LEFT & CENTER: MAIN CONTENT (9 Columns) -->
            <div class="lg:col-span-9 space-y-12">
                
                <!-- HERO SECTION -->
                <section class="relative rounded-[50px] h-[550px] shadow-2xl bg-slate-800 overflow-hidden" 
                         style="background-image: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.3) 70%), url('/tennis.jpeg'); background-size: cover; background-position: center;">
                    <div class="relative z-10 h-full flex flex-col justify-center px-12">
                        <h1 class="text-white text-6xl font-[800] leading-[0.95] tracking-tighter max-w-xl uppercase italic">
                            FIND YOUR GAME.<br />ANYTIME, ANYWHERE.
                        </h1>
                        <div class="flex flex-col md:flex-row items-start md:items-end gap-6 mt-8">
                            <p class="text-gray-200 text-sm max-w-xs font-medium opacity-90 leading-relaxed">
                                Join local clubs, enter community tournaments, and track your progress.
                            </p>
                            <a href="/openplays" class="bg-white text-black font-[800] px-8 py-4 rounded-full flex items-center gap-3 shadow-2xl hover:bg-orange-500 hover:text-white transition-all group whitespace-nowrap">
                                <span class="text-[11px] uppercase tracking-widest">Join an Open Play</span>
                                <div class="bg-black text-white rounded-full p-1 flex items-center justify-center font-bold">↗</div>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- TOURNAMENTS SECTION -->
                <section>
                    <div class="flex justify-between items-end mb-8">
                        <h2 class="text-4xl font-[800] tracking-tighter uppercase italic">Compete. Win.</h2>
                        <div class="flex gap-2">
                            <a href="/tournaments" class="px-5 py-2.5 border border-slate-200 rounded-xl text-[10px] font-bold uppercase tracking-widest bg-white">Browse All</a>
                            <a href="/create-tournament" class="px-5 py-2.5 bg-[#10B981] text-white rounded-xl text-[10px] font-bold uppercase tracking-widest shadow-lg">+ Create</a>
                        </div>
                    </div>

                    <div class="flex gap-6 overflow-x-auto pb-6 no-scrollbar scroll-smooth">
                        @for(int i=0; i<3; i++) {
                            <div class="tournament-card min-w-[380px] bg-white border border-slate-100 rounded-[32px] overflow-hidden hover:shadow-xl transition-all group p-2">
                                <div class="h-44 relative rounded-[24px] overflow-hidden">
                                    <img src="/tennis.jpeg" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-80" />
                                    <span class="absolute top-4 left-4 bg-orange-500 text-white px-3 py-1 rounded-lg text-[9px] font-black uppercase">Double Elimination</span>
                                </div>
                                <div class="p-6">
                                    <h3 class="text-xl font-[800] tracking-tight">Brooklyn Summer Slam</h3>
                                    <div class="mt-6 flex items-center justify-between">
                                        <p class="text-xl font-black">$80 <span class="text-[10px] text-slate-400 font-bold uppercase">/ team</span></p>
                                        <button class="bg-[#111111] text-white px-6 py-2.5 rounded-xl text-[10px] font-bold uppercase tracking-widest group-hover:bg-orange-600 transition-colors">Join →</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </section>
            </div>

            <!-- RIGHT: THE SIDELINE (3 Columns) -->
            <aside class="lg:col-span-3 space-y-6">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-xs font-[900] uppercase italic tracking-[0.2em] text-slate-400 flex items-center gap-2">
                        <span class="relative flex h-2 w-2">
                          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                        </span>
                        The Sideline
                    </h3>
                    <span class="text-[9px] font-bold text-slate-300 uppercase">Live Updates</span>
                </div>

                <div class="space-y-4">
                    <!-- Activity 1 -->
                    <div class="bg-white border border-slate-100 p-4 rounded-3xl shadow-sm hover:border-orange-200 transition-all cursor-pointer group">
                        <div class="flex gap-3">
                            <img src="https://i.pravatar.cc/100?u=1" class="w-10 h-10 rounded-full border-2 border-white shadow-sm" />
                            <div class="flex-1">
                                <p class="text-[11px] leading-tight">
                                    <span class="font-black text-slate-900">Marcus Wright</span> joined 
                                    <span class="font-black text-orange-500">Open Play: 4.0 Singles</span>
                                </p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">2 mins ago</p>
                            </div>
                        </div>
                    </div>

                    <!-- Activity 2 -->
                    <div class="bg-white border border-slate-100 p-4 rounded-3xl shadow-sm hover:border-orange-200 transition-all cursor-pointer">
                        <div class="flex gap-3">
                            <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center font-black text-xs border-2 border-white shadow-sm italic">W</div>
                            <div class="flex-1">
                                <p class="text-[11px] leading-tight">
                                    <span class="font-black text-slate-900">Sarah Chen</span> posted result: 
                                    <span class="font-black text-emerald-600">6-2, 6-4 Win</span>
                                </p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">1 hour ago</p>
                            </div>
                        </div>
                    </div>

                    <!-- Activity 3 -->
                    <div class="bg-white border border-slate-100 p-4 rounded-3xl shadow-sm hover:border-orange-200 transition-all cursor-pointer">
                        <div class="flex gap-3 text-slate-900">
                            <div class="w-10 h-10 bg-slate-900 rounded-full flex items-center justify-center text-sm shadow-sm">🏙️</div>
                            <div class="flex-1">
                                <p class="text-[11px] leading-tight">
                                    <span class="font-black text-slate-900">Brooklyn Aces</span> posted 4 new 
                                    <span class="font-black text-orange-500 underline underline-offset-2">Open Plays</span>
                                </p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">3 hours ago</p>
                            </div>
                        </div>
                    </div>

                    <!-- Activity 4 -->
                    <div class="bg-white border border-slate-100 p-4 rounded-3xl shadow-sm hover:border-orange-200 transition-all cursor-pointer group">
                        <div class="flex gap-3">
                            <img src="https://i.pravatar.cc/100?u=8" class="w-10 h-10 rounded-full border-2 border-white shadow-sm" />
                            <div class="flex-1">
                                <p class="text-[11px] leading-tight">
                                    <span class="font-black text-slate-900">Elena G.</span> entered 
                                    <span class="font-black text-orange-500">Summer Slam Bracket</span>
                                </p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase mt-1">Yesterday</p>
                            </div>
                        </div>
                    </div>

                    <!-- More Button -->
                    <button class="w-full py-3 text-[10px] font-black uppercase tracking-widest text-slate-400 hover:text-orange-500 transition-all bg-slate-50 rounded-2xl border border-dashed border-slate-200 mt-2">
                        View Full Activity
                    </button>
                </div>
            </aside>

        </div>
    </main>
</div>