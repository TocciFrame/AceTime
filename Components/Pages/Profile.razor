@page "/profile"

<div class="p-10 max-w-6xl mx-auto font-['Plus_Jakarta_Sans']">
    
    <!-- 1. PROFILE HEADER CARD -->
    <div class="bg-white rounded-[48px] p-10 shadow-sm border border-slate-100 mb-8 relative overflow-hidden">
        <!-- Visual Accent Decor -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-orange-50 rounded-bl-full -z-10 opacity-50"></div>
        
        <div class="flex flex-col md:flex-row items-center gap-10">
            <!-- Avatar with Level Ring -->
            <div class="relative">
                <div class="w-40 h-40 rounded-full border-4 border-orange-500 p-1.5 shadow-xl">
                    <img src="https://i.pravatar.cc/400?u=alex" class="w-full h-full rounded-full object-cover" />
                </div>
                <div class="absolute -bottom-2 -right-2 bg-slate-900 text-white px-4 py-1.5 rounded-full text-[10px] font-black uppercase border-4 border-white">
                    Pro
                </div>
            </div>

            <!-- Identity Info -->
            <div class="flex-1 text-center md:text-left">
                <div class="flex flex-col md:flex-row items-center gap-4">
                    <h1 class="text-5xl font-[800] tracking-tighter text-slate-900 uppercase italic">Alex Rivera</h1>
                    <span class="bg-emerald-50 text-emerald-600 px-3 py-1 rounded-lg text-[10px] font-black uppercase">Verified Athlete</span>
                </div>
                <p class="text-slate-400 font-bold text-xs uppercase tracking-[0.3em] mt-3">📍 Brooklyn, NY • Left-Handed • 6'2"</p>
                
                <div class="flex flex-wrap justify-center md:justify-start gap-3 mt-8">
                    <div class="bg-slate-50 px-6 py-3 rounded-2xl border border-slate-100">
                        <p class="text-[9px] font-black text-slate-400 uppercase">Tennis (UTR)</p>
                        <p class="text-xl font-[800]">8.42</p>
                    </div>
                    <div class="bg-slate-50 px-6 py-3 rounded-2xl border border-slate-100">
                        <p class="text-[9px] font-black text-slate-400 uppercase">Pickleball (DUPR)</p>
                        <p class="text-xl font-[800]">4.25</p>
                    </div>
                    <div class="bg-slate-50 px-6 py-3 rounded-2xl border border-slate-100">
                        <p class="text-[9px] font-black text-slate-400 uppercase">Ranking</p>
                        <p class="text-xl font-[800]">#142</p>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="flex flex-col gap-3">
                <button class="bg-[#111111] text-white px-8 py-4 rounded-2xl text-xs font-bold uppercase tracking-widest hover:bg-orange-600 transition-all shadow-lg">Edit Profile</button>
                <button class="bg-white border border-slate-200 text-slate-400 px-8 py-4 rounded-2xl text-xs font-bold uppercase tracking-widest hover:bg-slate-50 transition-all">Share Passport</button>
            </div>
        </div>
    </div>

    <!-- 2. LOWER CONTENT GRID -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Col: Bio & Gear -->
        <div class="lg:col-span-2 space-y-8">
            <!-- About Me -->
            <div class="bg-white rounded-[40px] p-8 border border-slate-100 shadow-sm">
                <h3 class="text-xl font-[800] uppercase italic tracking-tighter mb-4 text-slate-900">About Me</h3>
                <p class="text-slate-500 leading-relaxed font-medium">
                    Competitive tennis player for 10 years, recently transitioned into the Pickleball pro circuit in NYC. 
                    Always looking for high-intensity singles matches or competitive doubles sessions at McCarren Park.
                </p>
            </div>

            <!-- My Sports & Style -->
            <div class="bg-white rounded-[40px] p-8 border border-slate-100 shadow-sm">
                <h3 class="text-xl font-[800] uppercase italic tracking-tighter mb-6 text-slate-900">Preferred Play Style</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex items-center gap-4 bg-slate-50 p-5 rounded-3xl">
                        <span class="text-2xl">🎾</span>
                        <div>
                            <p class="font-bold text-sm">Aggressive Baseliner</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase">Tennis Style</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 bg-slate-50 p-5 rounded-3xl">
                        <span class="text-2xl">🏸</span>
                        <div>
                            <p class="font-bold text-sm">Strategic Dinker</p>
                            <p class="text-[10px] font-bold text-slate-400 uppercase">Pickleball Style</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Col: Achievements & Social -->
        <div class="space-y-8">
            <!-- Trophy Case -->
            <div class="bg-[#111111] rounded-[40px] p-8 shadow-2xl text-white relative overflow-hidden">
                <div class="absolute -top-10 -right-10 text-8xl opacity-10 rotate-12">🏆</div>
                <h3 class="text-xl font-[800] uppercase italic tracking-tighter mb-6 relative z-10">Trophy Case</h3>
                
                <div class="space-y-4 relative z-10">
                    <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10">
                        <span class="text-2xl">🥇</span>
                        <div>
                            <p class="font-bold text-sm">Summer Slam '24</p>
                            <p class="text-[9px] font-bold text-orange-500 uppercase tracking-widest">1st Place • Singles</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10">
                        <span class="text-2xl">🥉</span>
                        <div>
                            <p class="font-bold text-sm">NYC Open 2023</p>
                            <p class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">3rd Place • Doubles</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Connected Clubs -->
            <div class="bg-white rounded-[40px] p-8 border border-slate-100 shadow-sm">
                <h3 class="text-xl font-[800] uppercase italic tracking-tighter mb-6 text-slate-900">Member Of</h3>
                <div class="space-y-4">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-slate-900 rounded-xl flex items-center justify-center">🏙️</div>
                        <div>
                            <p class="font-bold text-sm">Brooklyn Aces</p>
                            <p class="text-[9px] font-bold text-slate-400 uppercase">Elite Club</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center">🥒</div>
                        <div>
                            <p class="font-bold text-sm">The Kitchen NYC</p>
                            <p class="text-[9px] font-bold text-slate-400 uppercase">Pickleball Community</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>