@page "/profile"
@using BlazorApp1.Services
@inject ProfileService ProfileService
@rendermode InteractiveServer

<div class="p-8 max-w-6xl mx-auto pb-20">
    <!-- Profile Card -->
    <div class="bg-white rounded-[40px] p-10 shadow-sm border border-slate-100 flex flex-col md:flex-row items-center gap-10 relative overflow-hidden">
        <!-- Pure Tailwind Decorative Element -->
        <div class="absolute -top-10 -right-10 w-64 h-64 bg-orange-500/5 rounded-full blur-3xl"></div>

        <div class="relative shrink-0">
            <div class="w-40 h-40 rounded-full border-4 border-orange-500 p-1.5 shadow-2xl bg-white">
                <img src="https://i.pravatar.cc/400?u=alex" class="w-full h-full rounded-full object-cover" />
            </div>
            <div class="absolute -bottom-1 -right-1 bg-slate-900 text-white px-4 py-1 rounded-full text-[10px] font-black uppercase border-4 border-white">Pro</div>
        </div>

        <div class="flex-1 text-center md:text-left">
            <h1 class="text-5xl font-[800] tracking-tighter text-slate-900 uppercase italic">@ProfileService.User.Name</h1>
            <p class="text-slate-400 font-bold text-[10px] uppercase tracking-[0.3em] mt-2">📍 @ProfileService.User.Location</p>
            
            <div class="flex gap-4 mt-8 justify-center md:justify-start">
                <div class="bg-slate-50 px-6 py-3 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Tennis</p>
                    <p class="text-xl font-black italic text-slate-900">@ProfileService.User.TennisRating</p>
                </div>
                <div class="bg-slate-50 px-6 py-3 rounded-2xl border border-slate-100">
                    <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest">Pickleball</p>
                    <p class="text-xl font-black italic text-slate-900">@ProfileService.User.PickleballRating</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-3 min-w-[200px]">
            <a href="/edit-profile" class="bg-slate-900 text-white px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest text-center hover:bg-orange-500 transition-all shadow-xl shadow-orange-500/10">Edit Profile</a>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-8">
        <div class="md:col-span-2 bg-white rounded-[40px] p-8 border border-slate-100 shadow-sm">
            <h3 class="text-xs font-black uppercase tracking-[0.2em] text-orange-500 mb-4 italic">Athlete Biography</h3>
            <p class="text-slate-600 leading-relaxed font-medium">@ProfileService.User.Bio</p>
        </div>
        
        <div class="bg-slate-900 rounded-[40px] p-8 shadow-2xl text-white relative overflow-hidden group">
            <div class="absolute -bottom-10 -right-10 text-9xl opacity-5 group-hover:rotate-12 transition-transform duration-700">🏆</div>
            <h3 class="text-xs font-black uppercase tracking-[0.2em] text-orange-400 mb-6 relative z-10 italic">Trophy Case</h3>
            <div class="space-y-4 relative z-10">
                <div class="flex items-center gap-4 bg-white/5 p-4 rounded-2xl border border-white/10 hover:bg-white/10 transition-all">
                    <span class="text-2xl">🥇</span>
                    <p class="font-bold text-sm uppercase">Summer Slam '24</p>
                </div>
            </div>
        </div>
    </div>
</div>