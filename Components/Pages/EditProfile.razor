@page "/edit-profile"
@using BlazorApp1.Services
@using BlazorApp1.Models
@inject ProfileService ProfileService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<div class="p-10 max-w-5xl mx-auto font-['Plus_Jakarta_Sans'] pb-32">
    @* ... (The rest of the HTML I gave you) ... *@
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12">
        <div>
            <a href="/profile" class="group text-slate-400 font-bold text-[10px] uppercase tracking-[0.3em] mb-4 flex items-center gap-2 hover:text-orange-500 transition-colors">
                ← Back to Passport
            </a>
            <h1 class="text-5xl font-[800] tracking-tighter text-slate-900 uppercase italic">Edit Profile</h1>
        </div>
        
        <div class="flex gap-4">
            <button @onclick='() => NavManager.NavigateTo("/profile")' class="px-8 py-4 rounded-2xl text-xs font-black uppercase tracking-widest text-slate-400 hover:bg-slate-100 transition-all">Cancel</button>
            <button @onclick='() => NavManager.NavigateTo("/profile")' class="px-10 py-4 bg-[#10B981] text-white rounded-2xl text-xs font-black uppercase tracking-widest shadow-lg shadow-emerald-200 hover:bg-emerald-600 transition-all">Save Changes</button>
        </div>
    </header>

    @* The Bindings causing the red lines will now work! *@
    <input type="text" @bind="ProfileService.User.Name" class="w-full bg-slate-50 border-none rounded-2xl py-4 px-6 text-sm font-bold text-slate-900 outline-none focus:ring-2 focus:ring-orange-500/20" />
    
    @* ... (Rest of the file) ... *@
</div>