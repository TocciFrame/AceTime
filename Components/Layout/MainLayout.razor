@inherits LayoutComponentBase
@inject NavigationManager NavManager

@{
    // Logic to hide sidebar on Auth pages
    var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
    bool isAuthPage = string.IsNullOrEmpty(uri) || uri.StartsWith("register");
    
    // Helper function to decide the CSS class for sidebar links
    string GetActiveClass(string pageName) {
        // If URI is "home" and pageName is "home", or if URI contains pageName
        bool isActive = (string.IsNullOrEmpty(uri) && pageName == "home") || uri.Contains(pageName);
        return isActive 
            ? "flex items-center gap-3 px-4 py-3 rounded-xl bg-orange-500 text-white font-bold shadow-lg shadow-orange-500/20" 
            : "flex items-center gap-3 px-4 py-3 rounded-xl text-slate-400 font-bold hover:bg-white/5 transition-all";
    }
}

<div class="flex h-screen bg-[#F8FAFC] overflow-hidden font-['Plus_Jakarta_Sans']">
    
    @if (!isAuthPage)
    {
        <!-- SIDEBAR -->
        <aside class="hidden lg:flex flex-col w-72 bg-[#0F172A] p-8 text-white z-50">
            <div class="text-2xl font-[800] italic tracking-tighter mb-12">
                Ace<span class="text-slate-500 not-italic font-[400]">Time</span>
            </div>

            <nav class="flex-1 space-y-2">
                <a href="/home" class="@GetActiveClass("home")">
                    <span>🏠</span> Home
                </a>
                
                <!-- NEW: Open Plays Link -->
                <a href="/openplays" class="@GetActiveClass("openplays")">
                    <span>🎾</span> Open Plays
                </a>
                
                <a href="/tournaments" class="@GetActiveClass("tournaments")">
                    <span>🏆</span> Tournaments
                </a>

                <a href="/history" class="@GetActiveClass("history")">
                    <span>🕒</span> Activity History
                </a>

                <a href="/myclubs" class="@GetActiveClass("myclubs")">
                    <span>🤝</span> My Clubs
                </a>
            </nav>

            <div class="pt-8 border-t border-slate-800">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-orange-400 font-bold hover:bg-white/5 transition-all">
                    <span>🚪</span> Log Out
                </a>
            </div>
        </aside>
    }

    <!-- MAIN CONTENT -->
    <main class="flex-1 overflow-y-auto relative">
        @Body
    </main>
</div>